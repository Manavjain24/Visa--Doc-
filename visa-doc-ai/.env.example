# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# SerpApi Configuration
SERPAPI_API_KEY=
SERPAPI_MAX_RESULTS=8
SERPAPI_TIMEOUT_SECONDS=10.0
SERPAPI_MAX_RETRIES=2

# Agentic Research Constraints
RESEARCH_MAX_ITERATIONS=3
RESEARCH_MAX_SEARCH_BUDGET=5

# Content Ingestion Security & Limits
INGESTION_TIMEOUT_SECONDS=10.0
INGESTION_MAX_CONTENT_LENGTH=100000

# Database
DATABASE_URL=sqlite:///./visadoc.db

# AI / LLM Configuration
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=
GEMINI_API_KEY=
